    <text x="52" y="93" text-anchor="middle" font-family="Fraunces, Georgia, serif" font-weight="700" font-size="96" fill="#1F4D3F">S</text>
  </g>
  <g transform="matrix(1 -0.5774 0 1 220 150)">
    <text x="52" y="93" text-anchor="middle" font-family="Fraunces, Georgia, serif" font-weight="700" font-size="96" fill="#1F4D3F">S</text>
  </g>
</svg>

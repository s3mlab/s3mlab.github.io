---
// Hero illustration: a cube with an S on each of three faces (S³) and an M badge on the open ring.
---

<svg
  class="cube"
  viewBox="0 -34 440 344"
  role="img"
  aria-label="A cube with the letter S on each of three faces and an M on the ring: S cubed M"
>
  <circle
    cx="220"
    cy="150"
    r="148"
    fill="none"
    stroke="#E8B04A"
    stroke-width="3"
    stroke-dasharray="850 80"
    stroke-linecap="round"
    transform="rotate(-74.5 220 150)"></circle>
  <circle cx="220" cy="2" r="27" fill="#E8B04A" stroke="#1F4D3F" stroke-width="3"></circle>
  <text
    x="220"
    y="12"
    text-anchor="middle"
    font-family="Fraunces, Georgia, serif"
    font-weight="700"
    font-size="32"
    fill="#1F4D3F">M</text>

  <polygon points="220,30 324,90 220,150 116,90" fill="#F4EFE3" stroke="#1F4D3F" stroke-width="3" stroke-linejoin="round"></polygon>
  <polygon points="116,90 220,150 220,270 116,210" fill="#E8B04A" stroke="#1F4D3F" stroke-width="3" stroke-linejoin="round"></polygon>

---
import Base from '../layouts/Base.astro';
import { url } from '../utils';
import { alignment, layers, stigmaTopics, wellbeingTopics, methods, howWeWork } from '../data/research';
---

<Base title="Research" current="research" description="Research areas of the Stigma Science & Social Medicine Lab: stigma, mental health, quality of life, and models of care.">
  <section class="page-head">
    <div class="container">
      <h1>Research</h1>
      <p>
        Social medicine asks how social conditions shape health. Stigma science asks how stigma can
        be measured, explained, and changed. We bring the two together to improve life with chronic
        illness.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <h2>Liberation from fear, on four levels</h2>
      <p class="intro">
        Stigma is more than language. We see it as fear, felt by others and carried within ourselves,
        so lasting change has to reach beyond words to the places where fear takes hold.
      </p>
      <div class="grid four">
        {
          layers.map((l) => (
            <article class="card">
              <span class="tag">{l.tag}</span>
              <h3>{l.title}</h3>
              <p>{l.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="block alt">
    <div class="container">
      <h2>Where our work fits</h2>
      <p class="intro">
        Our questions sit within two shared agendas, one in social work and one in global health.
      </p>
      <div class="grid two">
        {
          alignment.map((a) => (
            <article class="card">
              <span class="tag">{a.tag}</span>
              <h3>{a.title}</h3>
              <p>{a.body}</p>
              <p><a href={a.href} rel="noopener">{a.link}</a></p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <h2>Stigma</h2>
      <div class="grid three">
        {
          stigmaTopics.map((t) => (
            <article class="card">
              <h3>{t.title}</h3>
              <p>{t.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="block alt">
    <div class="container">
      <h2>Mental health and wellbeing</h2>
      <p class="intro">
        We look beyond viral suppression to the broader health, psychosocial, and quality-of-life
        outcomes that matter to people living with chronic illness.
      </p>
      <ul class="chips">
        {wellbeingTopics.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <h2>How we work</h2>
      <div class="grid two">
        {
          howWeWork.map((h) => (
            <article class="card">
              <h3>{h.title}</h3>
              <p>{h.body}</p>
            </article>
          ))
        }
      </div>
      <h3 style="margin-top: 2rem">Methods</h3>
      <ul class="chips">
        {methods.map((m) => <li>{m}</li>)}
      </ul>
    </div>
  </section>

  <section class="block alt">
    <div class="container">
      <h2>What we mean</h2>
      <div class="grid two">
        <article class="card">
          <h3>Stigma science</h3>
          <p>
            We treat stigma as a process that can be measured, explained, and changed, not only as a
            matter of language. Our working view is that stigma is, at its root, fear: the fear
            others hold and the fear people carry within themselves.
          </p>
        </article>
        <article class="card">
          <h3>Social medicine</h3>
          <p>
            Social medicine is a tradition of scholarship and practice that treats health and illness
            as inseparable from the social conditions in which people live. It asks how laws,
            economies, institutions, and relationships shape health, and how care can change them.
          </p>
        </article>
      </div>
      <p style="margin-top: 2rem">
        Interested in working together? <a href={url('/join/')}>Get in touch</a>.
      </p>
    </div>
  </section>
</Base>
